            actual = bounds(layer);
            if (actual[0] < box[0] - .5 || actual[1] < box[1] - .5 ||
                actual[2] > box[0]+box[2]+.5 || actual[3] > box[1]+box[3]+.5) throw Error(region.id + ': chữ vượt vùng an toàn');
            layer.move(group, ElementPlacement.INSIDE);
            return layer;
        } catch (e) { try { layer.remove(); } catch (_) {} throw e; }
        finally { if(typeof previousQuotes==='boolean')app.preferences.smartQuotes=previousQuotes; }
    }
    // Recovery placement deliberately does not promise to fit the region.
    // Preserve the whole string in a visible, movable Photoshop text layer.
    function addFallbackText(doc, group, text, options, center, name, maxWidth) {
        var layer = doc.artLayers.add(), previousQuotes = app.preferences.smartQuotes;
        try {
            if (typeof previousQuotes === 'boolean') app.preferences.smartQuotes = false;
            layer.kind = LayerKind.TEXT; layer.name = name;
            var t = layer.textItem; t.kind = TextType.POINTTEXT;
            try { t.font = options.font; } catch (_) { t.font = 'ArialMT'; }
            t.justification = Justification.CENTER;
            t.size = UnitValue(Math.max(4, options.min) * 72 / doc.resolution, 'pt');
            t.useAutoLeading = false; t.leading = UnitValue(Math.max(4, options.min) * options.leading * 72 / doc.resolution, 'pt');
            t.position = [UnitValue(center[0], 'px'), UnitValue(center[1], 'px')];
            var color = new SolidColor(); color.rgb.red = 0; color.rgb.green = 0; color.rgb.blue = 0; t.color = color;
            var paragraphs=String(text).replace(/\r\n|\r/g,'\n').split('\n'), output=[];
            var limit=Math.max(20,Math.min(Number(maxWidth)||doc.width.as('px')*.35,doc.width.as('px')*.8));
            for(var p=0;p<paragraphs.length;p++){
                var words=paragraphs[p].split(/\s+/), line='';
                for(var n=0;n<words.length;n++){
                    if(!words[n])continue;
                    var next=line ? line+' '+words[n] : words[n];
                    t.contents=next;var measured=bounds(layer);
                    if(line && measured[2]-measured[0]>limit){output.push(line);line=words[n];}
                    else line=next;
                }
                output.push(line);
            }
            t.contents=output.join('\r');
            layer.move(group, ElementPlacement.INSIDE);
            return layer;
        } catch (e) { try { layer.remove(); } catch (_) {} throw e; }
        finally { if (typeof previousQuotes === 'boolean') app.preferences.smartQuotes = previousQuotes; }
    }
    function addOverlay(doc, file, name) {
        var image = null;
        try {
            image = app.open(new File(file));
            // Photoshop UnitValue conversions can differ from integer pixel
            // dimensions by floating-point rounding (e.g. 960.0000000000001).
            if (Math.round(image.width.as('px')) !== Math.round(doc.width.as('px')) || Math.round(image.height.as('px')) !== Math.round(doc.height.as('px')))
                throw Error('Ảnh clean và tài liệu không cùng kích thước');
            var originalBounds = bounds(image.activeLayer);
            var layer = image.activeLayer.duplicate(doc, ElementPlacement.PLACEATBEGINNING);
            image.close(SaveOptions.DONOTSAVECHANGES); image = null;
            app.activeDocument = doc;
            var copiedBounds = bounds(layer);
            layer.translate(UnitValue(originalBounds[0]-copiedBounds[0], 'px'), UnitValue(originalBounds[1]-copiedBounds[1], 'px'));
            layer.name = name || 'CLEAN / REDRAW';
            return layer;
        } finally { if (image) image.close(SaveOptions.DONOTSAVECHANGES); app.activeDocument = doc; }
    }
    function translationKey(parsed,name,index) {
        var match=/(\d+)(?=\.[^.]+$)/.exec(decodeURI(name));
        if(parsed.marked && match && (parsed.filename_pages || parsed.pages[String(Number(match[1]))])) return String(Number(match[1]));
        return parsed.marked ? String(index+1) : '1';
    }
    function sourceNameAllowed(name){
        name=decodeURI(name);
        return /\.(jpe?g|png|psd)$/i.test(name) && !/_(clean|typeset)(?:_\d+)?\.(jpe?g|png|psd)$/i.test(name);
    }
    // The user's automatic roles follow balloon geometry, not punctuation.
    function suggestTextRole(region, translation) {
        if (region.bubble_font_style === 'dialogue' || region.bubble_font_style === 'box' || region.bubble_font_style === 'shout') return region.bubble_font_style;
        if (region.detector === 'comic_text_ai') return 'dialogue';
        var p = region.outline, b = region.box, area = 0;
        if (p && p.length >= 4 && b && b[2] > 0 && b[3] > 0) {
            for (var i = 0; i < p.length; i++) {
                var next = p[(i + 1) % p.length];
                area += p[i][0] * next[1] - next[0] * p[i][1];
            }
            if (Math.abs(area) / 2 / (b[2] * b[3]) >= 0.90) return 'box';
        }
        return 'dialogue';
    }
    function resolveTextRole(region, translation, selected, automatic) {
        if (selected === 'dialogue' || selected === 'box' || selected === 'shout') return selected;
        return automatic ? suggestTextRole(region, translation) : 'dialogue';
    }
    function shapeWidth(shape,top,bottom,cx) {
        var left=-Infinity,right=Infinity,found=0;
        for(var i=0;i<shape.rows.length;i++){var r=shape.rows[i];if(r[0]>=Math.floor(top) && r[0]<Math.ceil(bottom)){left=Math.max(left,r[1]);right=Math.min(right,r[2]);found++;}}
        if(found<Math.ceil(bottom)-Math.floor(top))return 0;
        return Math.max(0,2*Math.min(cx-left,right-cx));
    }
    function shapeRectFits(shape,left,top,right,bottom) {
        return right-left<=shapeWidth(shape,top,bottom,(left+right)/2)-1;
    }
    function wrapToWidths(paragraphs,widths,measure) {
        var words=[],i;
        for(i=0;i<paragraphs.length;i++)words.push(paragraphs[i].replace(/^\s+|\s+$/g,'').split(/\s+/));
        var memo={};
        function solve(row,paragraph,start){
            if(row===widths.length)return paragraph===words.length?{cost:0,lines:[]}:null;
            if(paragraph>=words.length || widths[row]<=0)return null;
            var key=row+':'+paragraph+':'+start;
            if(memo[key]!==undefined)return memo[key];
            var best=null,content='';
            for(var end=start;end<words[paragraph].length;end++){
                content+=(end>start?' ':'')+words[paragraph][end];
                var width=measure(content);if(width>widths[row])break;
                var next=end+1===words[paragraph].length;
                var tail=solve(row+1,next?paragraph+1:paragraph,next?0:end+1);
                if(!tail)continue;
                var cost=tail.cost+Math.pow((widths[row]-width)/widths[row],2);
                if(!best || cost<best.cost)best={cost:cost,lines:[content].concat(tail.lines)};
            }
            memo[key]=best;return best;
        }
        var result=solve(0,0,0);return result?result.lines:null;
    }
    function unmappedTranslations(lines, mapping) {
        function normal(s) { return String(s).replace(/\s/g,'').toLowerCase(); }
        var available=[],pending=[],order=[],i,j;
        for(i=0;i<mapping.length;i++)available.push(normal(mapping[i].translation));
        for(i=0;i<lines.length;i++)if(normal(lines[i]))order.push({index:i,text:normal(lines[i])});
        // Consume longer lines first, so "..." inside a sentence cannot count
        // as an additional standalone utterance. Duplicate lines need copies.
        order.sort(function(a,b){return b.text.length-a.text.length;});
        for(i=0;i<order.length;i++){
            var found=false;
            for(j=0;j<available.length;j++){
                var at=available[j].indexOf(order[i].text);
                if(at>=0){available[j]=available[j].substr(0,at)+'|'+available[j].substr(at+order[i].text.length);found=true;break;}
            }
            if(!found)pending.push(order[i].index);
        }
        pending.sort(function(a,b){return a-b;});return pending;
    }
    function mergeNextTranslation(lines,mapping,index) {
        if(index<0 || index>=mapping.length-1)throw Error('Chọn vùng có câu kế tiếp để gộp.');
        var texts=[],probe=[],i;
        for(i=0;i<mapping.length;i++)texts.push(mapping[i].translation);
        texts[index]+=(texts[index]?'\n':'')+texts[index+1];texts.splice(index+1,1);
        for(i=0;i<texts.length;i++)probe.push({translation:texts[i]});
        var missing=unmappedTranslations(lines,probe);
        texts.push(missing.length?lines[missing[0]]:'');return texts;
    }
    function hitRegion(regions, width, height, imageWidth, imageHeight, controlWidth, controlHeight, x, y) {
        x=(x-(controlWidth-imageWidth)/2)*width/imageWidth;
        y=(y-(controlHeight-imageHeight)/2)*height/imageHeight;
        var best=-1, area=Infinity;
        for(var i=0;i<regions.length;i++) { var b=regions[i].box;
            if(x>=b[0] && y>=b[1] && x<b[0]+b[2] && y<b[1]+b[3] && b[2]*b[3]<area){best=i;area=b[2]*b[3];}
        }
        return best;
    }
    function editSafe(region, rect) {
        var limit = region.safe_limit || region.safe;
        for (var i=0;i<4;i++) if(typeof rect[i] !== 'number' || !isFinite(rect[i]) || Math.floor(rect[i]) !== rect[i]) throw Error('Tọa độ phải là số nguyên');
        if(rect[2]<=0 || rect[3]<=0 || rect[0]<limit[0] || rect[1]<limit[1] || rect[0]+rect[2]>limit[0]+limit[2] || rect[1]+rect[3]>limit[1]+limit[3]) throw Error('Vùng chữ phải nằm trong vùng an toàn ban đầu. Thêm vùng thủ công nếu cần mở rộng.');
        region.safe_limit=limit.slice(0); region.safe=rect.slice(0);
