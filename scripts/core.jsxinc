            // dimensions by floating-point rounding (e.g. 960.0000000000001).
            if (Math.round(image.width.as('px')) !== Math.round(doc.width.as('px')) || Math.round(image.height.as('px')) !== Math.round(doc.height.as('px')))
                throw Error('Ảnh clean và tài liệu không cùng kích thước');
            var originalBounds = bounds(image.activeLayer);
            var layer = image.activeLayer.duplicate(doc, ElementPlacement.PLACEATBEGINNING);
            image.close(SaveOptions.DONOTSAVECHANGES); image = null;
            app.activeDocument = doc;
            var copiedBounds = bounds(layer);
            layer.translate(UnitValue(originalBounds[0]-copiedBounds[0], 'px'), UnitValue(originalBounds[1]-copiedBounds[1], 'px'));
            layer.name = name || 'CLEAN / REDRAW';
