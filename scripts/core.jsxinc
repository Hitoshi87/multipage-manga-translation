/* Photoshop-only operations; shared by the UI and real Photoshop smoke tests. */
var MTA = (function () {
    var serial = 0;
    var uiVersion = '1107-ui.6';
    function inputPolicy(engineId, mode) {
        var legacy = engineId === 'baseline', clean = !mode.alreadyClean;
        return {legacyTools:legacy && clean, fullPage:legacy && clean,
                clean:clean && !mode.modelBatch, preview:clean && !mode.modelBatch,
                typeset:!mode.cleanOnly, review:!mode.modelBatch,
                skipMismatch:!mode.cleanOnly && !mode.reviewAll && !mode.modelBatch,
                detail:!!mode.aiDetector};
    }
    function enginePreviewMapping(regions, saved, engineId) {
        var result=[];
        for(var i=0;i<regions.length;i++){
            var old=null;
            for(var j=0;j<(saved || []).length;j++)if(saved[j].id===regions[i].id)old=saved[j];
            result.push({id:regions[i].id,translation:'Xem thử',clean:old?old.clean!==false:true,
                         force:engineId==='baseline' && !!(old && old.force)});
        }
        return result;
    }
    function cleanSelection(region, mapping, engineId) {
        // Selection is user intent. Only the legacy baseline UI uses its
        // auto-clean flag to gate the checkbox; engines validate their own mask.
        return mapping.clean === true && (engineId !== 'baseline' || region.auto_clean || mapping.force === true);
    }
    function cleanControlEnabled(hasMask, offline, fullPage, engineId) {
        return !offline && !fullPage && (engineId !== 'baseline' || hasMask);
    }
    function cleanRegionStatus(region, engineId) {
        if (engineId !== 'baseline') return 'Engine ' + engineId + ' sẽ kiểm tra';
        return region.auto_clean ? 'Clean được' : 'CLEAN THỦ CÔNG';
    }
    function savedEngine(entry, queued, data) {
        return (entry && entry.engine) || (queued && queued.engine) ||
               (data && data.engine_selection) || {id:'baseline',version:'baseline-1'};
    }
    function cleanResultSummary(result) {
        var review = result.review_ids || [], skipped = [], legacy = result.skipped || [];
        for (var i = 0; i < legacy.length; i++) {
            var needsReview = false;
            for (var j = 0; j < review.length; j++) if (legacy[i] === review[j]) needsReview = true;
            if (!needsReview) skipped.push(legacy[i]);
        }
        return (review.length ? ' — cần duyệt kết quả: ' + review.join(', ') : '') +
               (skipped.length ? ' — chưa clean: ' + skipped.join(', ') : '');
    }
    function text(file) {
        file = file instanceof File ? file : new File(file);
        file.encoding = 'UTF8';
        if (!file.open('r')) throw Error('Không đọc được: ' + file.fsName);
        var s; try { s = file.read(); } finally { file.close(); }
        return s;
    }
    function write(file, content) {
        file = file instanceof File ? file : new File(file);
        file.encoding = 'UTF8'; file.lineFeed = 'Unix';
        if (!file.open('w')) throw Error('Không ghi được: ' + file.fsName);
        try { if (!file.write(content)) throw Error('Ghi file thất bại: ' + file.fsName); }
        finally { file.close(); }
    }
    // Keep the last readable checkpoint if Photoshop terminates during a write.
    function writeCheckpoint(file, content) {
        file = file instanceof File ? file : new File(file);
        var backup = new File(file.fsName + '.bak');
        if (file.exists) {
            var readable = false;
            try { MJSON.parse(text(file)); readable = true; } catch (_) {}
            if (readable && !file.copy(backup.fsName)) throw Error('Không sao lưu được checkpoint');
            if (!readable && !backup.exists) throw Error('Checkpoint bị hỏng và không có bản sao: ' + file.fsName);
        }
        write(file, content);
    }
    function validOutput(path) {
        if (!path) return false;
        var f = new File(path), opened = false;
        if (!f.exists || f.length < 16) return false;
        try {
            f.encoding = 'BINARY'; opened = f.open('r'); if (!opened) return false;
            var head = f.read(5);
            if (/\.pdf$/i.test(path)) {
                if (head !== '%PDF-') return false;
                f.seek(Math.max(0, f.length - 2048), 0);
                return f.read().indexOf('%%EOF') >= 0;
            }
            return /\.psd$/i.test(path) && head.substr(0, 4) === '8BPS';
        } catch (_) { return false; } finally { if (opened) f.close(); }
    }
    function mkdir(path) {
        var folder = path instanceof Folder ? path : new Folder(path);
        if (!folder.exists) {
            if (!folder.parent.exists) mkdir(folder.parent);
            if (!folder.create()) throw Error('Không tạo được thư mục: ' + folder.fsName);
        }
        return folder;
    }
    function unique() { serial++; return (new Date()).getTime() + '_' + serial; }
    // Keep project state tied to the selected input and its current files, even
    // when multiple folders share one output directory. Sort for stable resume.
    function sourceProjectKey(folder, files) {
        var entries=[], i, f, modified;
        for(i=0;i<files.length;i++){
            f=files[i];modified=f.modified;
            entries.push(String(f.fsName||f.name)+'\u0000'+String(f.length||0)+'\u0000'+
                         String(modified && modified.getTime ? modified.getTime() : 0));
        }
        entries.sort();
        var value=String(folder)+'\u0000'+entries.join('\u0001'), a=2166136261, b=2246822519;
        for(i=0;i<value.length;i++){
            a^=value.charCodeAt(i);a=(a+(a<<1)+(a<<4)+(a<<7)+(a<<8)+(a<<24))>>>0;
            b^=value.charCodeAt(i);b=(b+(b<<1)+(b<<4)+(b<<7)+(b<<8)+(b<<24))>>>0;
        }
        return ('00000000'+a.toString(16)).slice(-8)+('00000000'+b.toString(16)).slice(-8);
    }
    // Recognize one rename only when the previous complete fingerprint is
    // reconstructed and the chronological order is unchanged. Fingerprints
    // cover paths, sizes and mtimes, not file contents.
    function sourceRenameCandidate(folder, files, oldName, expectedKey) {
        oldName=String(oldName);if(!oldName || /[\\\/]/.test(oldName))return null;
        var i,j,now=[],candidate=null,matches=0;
        function natural(a,b){
            var aa=a.match(/\d+|\D+/g),bb=b.match(/\d+|\D+/g);
            for(var z=0;z<Math.min(aa.length,bb.length);z++){
                var av=/^\d+$/.test(aa[z])?Number(aa[z]):aa[z].toLowerCase();
                var bv=/^\d+$/.test(bb[z])?Number(bb[z]):bb[z].toLowerCase();
                if(av<bv)return -1;if(av>bv)return 1;
            }
            return aa.length-bb.length;
        }
        for(i=0;i<files.length;i++){now.push(decodeURI(files[i].name));if(decodeURI(files[i].name)===oldName)return null;}
        var sortedNow=now.slice(0).sort(natural),rank={};
        for(i=0;i<sortedNow.length;i++)rank[sortedNow[i]]=i;
        for(i=0;i<files.length;i++){
            var renamed=decodeURI(files[i].name),pos=rank[renamed];
            // The old name must occupy exactly the same sorted slot. Reject
            // equal natural-sort keys, whose order is not deterministic.
            if((pos>0 && natural(sortedNow[pos-1],oldName)>=0) ||
               (pos+1<sortedNow.length && natural(oldName,sortedNow[pos+1])>=0))continue;
            var prior=files.slice(0),f=files[i];
            prior[i]={fsName:(new File(folder+'/'+oldName)).fsName,name:oldName,length:f.length,modified:f.modified};
            if(sourceProjectKey(folder,prior)===expectedKey){matches++;candidate=renamed;}
        }
        return matches===1?candidate:null;
    }
    function automaticClickAllowed(running,lastAction,lastEnd,action,now) {
        return !running && !(lastAction===action && now-lastEnd<1500);
    }
    function confirmChapter(rows, mode, reviewMode) {
        var dlg = new Window('dialog', 'Xác nhận thứ tự chương');
        dlg.orientation = 'column'; dlg.alignChildren = 'fill';
        dlg.add('statictext', undefined, 'Thứ tự chương (' + rows.length + ' trang):');
        var list = dlg.add('listbox', undefined, rows);
        list.preferredSize = [560, 280];
        dlg.add('statictext', undefined, 'Nhận diện: ' + mode);
        dlg.add('statictext', undefined, reviewMode);
        var buttons = dlg.add('group'); buttons.alignment = 'right';
        buttons.add('button', undefined, 'Hủy', {name:'cancel'});
        buttons.add('button', undefined, 'Bắt đầu', {name:'ok'});
        dlg.center();
        return dlg.show() === 1;
    }
    function shell(s) { return "'" + String(s).replace(/'/g, "'\\''") + "'"; }
    function vbLiteral(s) { return '"' + String(s).replace(/"/g, '""') + '"'; }
    function request(root, payload, tick) {
        var windows = /^windows/i.test($.os);
        var python = new File(root.fsName + (windows ? '/.venv/Scripts/python.exe' : '/.venv/bin/python'));
        if (!python.exists) throw Error('Thiếu Python trong .venv. Hãy cài môi trường của dự án.');
        var dir = mkdir(root.fsName + '/work/jobs/' + unique());
        var input = new File(dir.fsName + '/request.json');
        var output = new File(dir.fsName + '/response.json');
        var cancel = new File(dir.fsName + '/cancel');
        var heartbeatPath = dir.fsName + '/heartbeat';
        payload.cancel = cancel.fsName;
        write(input, MJSON.stringify(payload));
        var accel = payload.accel || 'auto';
        if (windows) {
            // WScript.Shell.Run launches the worker directly without cmd.exe
            // interpolation. WScript expands %ENV%; reject it in paths.
            var paths=[python.fsName,root.fsName+'/manga_typesetter.py',input.fsName,output.fsName,dir.fsName];
            for(var wi=0;wi<paths.length;wi++)if(/[%\r\n]/.test(paths[wi]))throw Error('Đường dẫn Windows chứa % hoặc xuống dòng không được hỗ trợ.');
            var launcher=new File(dir.fsName+'/launch.vbs');launcher.encoding='UTF-16';launcher.lineFeed='Windows';
            if(!launcher.open('w'))throw Error('Không tạo được launcher Windows.');
            try { launcher.write('Set sh = CreateObject("WScript.Shell")\r\n' +
                'sh.Environment("PROCESS")("OMP_THREAD_LIMIT") = "1"\r\nsh.Environment("PROCESS")("OPENBLAS_NUM_THREADS") = "1"\r\n' +
                'sh.Environment("PROCESS")("MANGA_ACCEL") = "' + accel + '"\r\n' +
                'q = Chr(34)\r\ncmd = q & '+vbLiteral(paths[0])+' & q & " " & q & '+vbLiteral(paths[1])+' & q & " --request " & q & '+vbLiteral(paths[2])+' & q & " --response " & q & '+vbLiteral(paths[3])+' & q\r\nsh.Run cmd, 0, False\r\n'); }
            finally { launcher.close(); }
            app.system('wscript.exe //B "'+launcher.fsName+'"');
        } else {
            var command = 'OMP_THREAD_LIMIT=1 OPENBLAS_NUM_THREADS=1 MANGA_ACCEL=' + shell(accel) + ' ' + shell(python.fsName) + ' ' +
                shell(root.fsName + '/manga_typesetter.py') + ' --request ' + shell(input.fsName) +
                ' --response ' + shell(output.fsName) + ' > ' + shell(dir.fsName + '/worker.log') + ' 2>&1 &';
            app.system('/bin/sh -c ' + shell(command));
        }
        var start = (new Date()).getTime(), lastSignal = start, prevCheck = start, lastNoticeMinute = 0, sawHeartbeat = false;
        while (!output.exists) {
            var now = (new Date()).getTime(), beat = new File(heartbeatPath);
            if (now - prevCheck > 5000 && lastSignal < now) lastSignal = Math.min(now, lastSignal + (now - prevCheck));
            prevCheck = now;
            if (beat.exists && beat.modified) {
                var beatTime = beat.modified.getTime();
                if (isFinite(beatTime) && beatTime >= start - 5000 && beatTime <= now + 5000) {
                    sawHeartbeat = true;
                    if (beatTime > lastSignal) lastSignal = beatTime;
                }
            }
            var minute = Math.floor((now - start) / 60000), note = null;
            if (sawHeartbeat && minute >= 3 && minute !== lastNoticeMinute && now - lastSignal <= 180000) {
                note = 'Python còn gửi tín hiệu, đã chờ ' + minute + ' phút; có thể hủy nếu cần.';
                lastNoticeMinute = minute;
            }
            if (tick && tick(note) === false) { write(cancel, 'cancel'); throw Error('Đã hủy; backend sẽ dừng tại điểm an toàn.'); }
            if (now - lastSignal > 180000) {
                if (output.exists) break;
                write(cancel, 'timeout');
                var lost = Error('Python không có tín hiệu trong 180 giây (' + String(payload.operation || 'không rõ bước') + '). Đã yêu cầu dừng; kiểm tra worker đã kết thúc trước khi chạy lại. Xem ' + dir.fsName + '/worker.log và request.json. Các trang đã xuất vẫn được giữ.');
                lost.workerUnresponsive = true;
                throw lost;
            }
            $.sleep(120);
        }
        var response = MJSON.parse(text(output));
        if (!response.ok) throw Error(response.error + '\nLog: ' + dir.fsName + '/worker.log');
        try {
            if (input.remove) input.remove();
            if (output.remove) output.remove();
            if (cancel.remove) cancel.remove();
            var beatFile = new File(heartbeatPath); if (beatFile.exists && beatFile.remove) beatFile.remove();
            var logFile = new File(dir.fsName + '/worker.log'); if (logFile.exists && logFile.remove) logFile.remove();
            var vbsFile = new File(dir.fsName + '/launch.vbs'); if (vbsFile.exists && vbsFile.remove) vbsFile.remove();
            if (dir.remove) dir.remove();
        } catch (_) {}
        return response.result;
    }
    function snapshot(doc, folder) {
        var copy = null;
        try {
            app.activeDocument = doc;
            copy = doc.duplicate('MTA snapshot', true);
            if (copy.mode !== DocumentMode.RGB) copy.changeMode(ChangeMode.RGB);
            copy.bitsPerChannel = BitsPerChannelType.EIGHT;
            var file = new File(folder.fsName + '/input.png');
            var pngOptions=new PNGSaveOptions();pngOptions.compression=3;pngOptions.interlaced=false;
            copy.saveAs(file, pngOptions, true, Extension.LOWERCASE);
            return file;
        } finally { if (copy) copy.close(SaveOptions.DONOTSAVECHANGES); app.activeDocument = doc; }
    }
    function bounds(layer) {
        var b = layer.bounds;
        return [b[0].as('px'), b[1].as('px'), b[2].as('px'), b[3].as('px')];
    }
    function addWhiteStroke(doc, layer, pixels, rgb) {
        // New text layers only; preserves editable text. If this Photoshop
        // version rejects layer effects, the caller records a review issue.
        try {
            app.activeDocument=doc;doc.activeLayer=layer;
            var id=charIDToTypeID, action=new ActionDescriptor(), ref=new ActionReference();
            ref.putProperty(id('Prpr'),id('Lefx'));ref.putEnumerated(id('Lyr '),id('Ordn'),id('Trgt'));
            action.putReference(id('null'),ref);
            var effects=new ActionDescriptor(), stroke=new ActionDescriptor(), color=new ActionDescriptor();
            effects.putUnitDouble(id('Scl '),id('#Prc'),100);
            stroke.putBoolean(id('enab'),true);
            stroke.putEnumerated(id('Styl'),id('FStl'),id('OutF'));
            stroke.putEnumerated(id('PntT'),id('FrFl'),id('SClr'));
            stroke.putEnumerated(id('Md  '),id('BlnM'),id('Nrml'));
            stroke.putUnitDouble(id('Opct'),id('#Prc'),100);
            stroke.putUnitDouble(id('Sz  '),id('#Pxl'),pixels);
            rgb=rgb||[255,255,255];
            color.putDouble(id('Rd  '),rgb[0]);color.putDouble(id('Grn '),rgb[1]);color.putDouble(id('Bl  '),rgb[2]);
            stroke.putObject(id('Clr '),id('RGBC'),color);effects.putObject(id('FrFX'),id('FrFX'),stroke);
            action.putObject(id('T   '),id('Lefx'),effects);executeAction(id('setd'),action,DialogModes.NO);
            return true;
        } catch (_) { return false; }
    }
