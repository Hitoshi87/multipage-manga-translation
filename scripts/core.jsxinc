        var rows={}, area=0, i, cx0=shape.center[0], cy0=shape.center[1], maxWidth=0;
        for(i=0;i<shape.rows.length;i++){rows[shape.rows[i][0]]=shape.rows[i];area+=shape.rows[i][2]-shape.rows[i][1];maxWidth=Math.max(maxWidth,shape.rows[i][2]-shape.rows[i][1]);}
