            return {size:size,lines:lines,dx:axis-cx0,dy:dy,axis:axis,cy:cy0+dy,top:top0,baseline:top0+acc,rh:rh,lead:lead,usage:used/sum,quality:wrapped.cost/2.5+3*Math.abs(axis-cx0)/Math.max(1,bw)+3*Math.abs(dy)/Math.max(1,bh)+sparse,fill:fillValue};
