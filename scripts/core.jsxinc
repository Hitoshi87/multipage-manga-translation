/* Photoshop-only operations; shared by the UI and real Photoshop smoke tests. */
var MTA = (function () {
    var serial = 0;
    var uiVersion = '1107-ui.4';
    function inputPolicy(engineId, mode) {
        var legacy = engineId === 'baseline', clean = !mode.alreadyClean;
        return {legacyTools:legacy && clean, fullPage:legacy && clean,
                clean:clean && !mode.modelBatch, preview:clean && !mode.modelBatch,
                typeset:!mode.cleanOnly, review:!mode.modelBatch,
                skipMismatch:!mode.cleanOnly && !mode.reviewAll && !mode.modelBatch,
                detail:!!mode.aiDetector};
    }
    function enginePreviewMapping(regions, saved, engineId) {
        var result=[];
        for(var i=0;i<regions.length;i++){
            var old=null;
            for(var j=0;j<(saved || []).length;j++)if(saved[j].id===regions[i].id)old=saved[j];
            result.push({id:regions[i].id,translation:'Xem thử',clean:old?old.clean!==false:true,
                         force:engineId==='baseline' && !!(old && old.force)});
        }
        return result;
    }
    function cleanSelection(region, mapping, engineId) {
        // Selection is user intent. Only the legacy baseline UI uses its
        // auto-clean flag to gate the checkbox; engines validate their own mask.
        return mapping.clean === true && (engineId !== 'baseline' || region.auto_clean || mapping.force === true);
    }
    function cleanControlEnabled(hasMask, offline, fullPage, engineId) {
        return !offline && !fullPage && (engineId !== 'baseline' || hasMask);
    }
    function cleanRegionStatus(region, engineId) {
        if (engineId !== 'baseline') return 'Engine ' + engineId + ' sẽ kiểm tra';
        return region.auto_clean ? 'Clean được' : 'CLEAN THỦ CÔNG';
    }
    function savedEngine(entry, queued, data) {
        return (entry && entry.engine) || (queued && queued.engine) ||
               (data && data.engine_selection) || {id:'baseline',version:'baseline-1'};
    }
    function cleanResultSummary(result) {
        var review = result.review_ids || [], skipped = [], legacy = result.skipped || [];
        for (var i = 0; i < legacy.length; i++) {
            var needsReview = false;
            for (var j = 0; j < review.length; j++) if (legacy[i] === review[j]) needsReview = true;
            if (!needsReview) skipped.push(legacy[i]);
        }
        return (review.length ? ' — cần duyệt kết quả: ' + review.join(', ') : '') +
               (skipped.length ? ' — chưa clean: ' + skipped.join(', ') : '');
    }
    function text(file) {
        file = file instanceof File ? file : new File(file);
        file.encoding = 'UTF8';
        if (!file.open('r')) throw Error('Không đọc được: ' + file.fsName);
        var s; try { s = file.read(); } finally { file.close(); }
        return s;
    }
    function write(file, content) {
        file = file instanceof File ? file : new File(file);
        file.encoding = 'UTF8'; file.lineFeed = 'Unix';
        if (!file.open('w')) throw Error('Không ghi được: ' + file.fsName);
        try { if (!file.write(content)) throw Error('Ghi file thất bại: ' + file.fsName); }
        finally { file.close(); }
    }
    function mkdir(path) {
        var folder = path instanceof Folder ? path : new Folder(path);
        if (!folder.exists) {
            if (!folder.parent.exists) mkdir(folder.parent);
            if (!folder.create()) throw Error('Không tạo được thư mục: ' + folder.fsName);
        }
        return folder;
    }
    function unique() { serial++; return (new Date()).getTime() + '_' + serial; }
    function confirmChapter(rows, mode, reviewMode) {
        var dlg = new Window('dialog', 'Xác nhận thứ tự chương');
        dlg.orientation = 'column'; dlg.alignChildren = 'fill';
        dlg.add('statictext', undefined, 'Thứ tự chương (' + rows.length + ' trang):');
        var list = dlg.add('listbox', undefined, rows);
        list.preferredSize = [560, 280];
        dlg.add('statictext', undefined, 'Nhận diện: ' + mode);
        dlg.add('statictext', undefined, reviewMode);
        var buttons = dlg.add('group'); buttons.alignment = 'right';
        buttons.add('button', undefined, 'Hủy', {name:'cancel'});
        buttons.add('button', undefined, 'Bắt đầu', {name:'ok'});
        dlg.center();
        return dlg.show() === 1;
    }
    function shell(s) { return "'" + String(s).replace(/'/g, "'\\''") + "'"; }
    function vbLiteral(s) { return '"' + String(s).replace(/"/g, '""') + '"'; }
    function request(root, payload, tick) {
        var windows = /^windows/i.test($.os);
        var python = new File(root.fsName + (windows ? '/.venv/Scripts/python.exe' : '/.venv/bin/python'));
        if (!python.exists) throw Error('Thiếu Python trong .venv. Hãy cài môi trường của dự án.');
        var dir = mkdir(root.fsName + '/work/jobs/' + unique());
        var input = new File(dir.fsName + '/request.json');
        var output = new File(dir.fsName + '/response.json');
        var cancel = new File(dir.fsName + '/cancel');
        payload.cancel = cancel.fsName;
        write(input, MJSON.stringify(payload));
        var accel = payload.accel || 'auto';
        if (windows) {
            // WScript.Shell.Run launches the worker directly without cmd.exe
            // interpolation. WScript expands %ENV%; reject it in paths.
            var paths=[python.fsName,root.fsName+'/manga_typesetter.py',input.fsName,output.fsName,dir.fsName];
            for(var wi=0;wi<paths.length;wi++)if(/[%\r\n]/.test(paths[wi]))throw Error('Đường dẫn Windows chứa % hoặc xuống dòng không được hỗ trợ.');
            var launcher=new File(dir.fsName+'/launch.vbs');launcher.encoding='UTF-16';launcher.lineFeed='Windows';
            if(!launcher.open('w'))throw Error('Không tạo được launcher Windows.');
            try { launcher.write('Set sh = CreateObject("WScript.Shell")\r\n' +
                'sh.Environment("PROCESS")("OMP_THREAD_LIMIT") = "1"\r\nsh.Environment("PROCESS")("OPENBLAS_NUM_THREADS") = "1"\r\n' +
                'sh.Environment("PROCESS")("MANGA_ACCEL") = "' + accel + '"\r\n' +
                'q = Chr(34)\r\ncmd = q & '+vbLiteral(paths[0])+' & q & " " & q & '+vbLiteral(paths[1])+' & q & " --request " & q & '+vbLiteral(paths[2])+' & q & " --response " & q & '+vbLiteral(paths[3])+' & q\r\nsh.Run cmd, 0, False\r\n'); }
            finally { launcher.close(); }
            app.system('wscript.exe //B "'+launcher.fsName+'"');
        } else {
            var command = 'OMP_THREAD_LIMIT=1 OPENBLAS_NUM_THREADS=1 MANGA_ACCEL=' + shell(accel) + ' ' + shell(python.fsName) + ' ' +
                shell(root.fsName + '/manga_typesetter.py') + ' --request ' + shell(input.fsName) +
                ' --response ' + shell(output.fsName) + ' > ' + shell(dir.fsName + '/worker.log') + ' 2>&1 &';
            app.system('/bin/sh -c ' + shell(command));
        }
        var start = (new Date()).getTime();
        while (!output.exists) {
            if (tick && tick() === false) { write(cancel, 'cancel'); throw Error('Đã hủy; backend sẽ dừng tại điểm an toàn.'); }
            if ((new Date()).getTime() - start > 180000) {
                write(cancel, 'timeout');
                throw Error('Python không phản hồi trong 180 giây. Xem ' + dir.fsName + '/worker.log; có thể dùng CLI tiền xử lý.');
            }
            $.sleep(120);
        }
        var response = MJSON.parse(text(output));
        if (!response.ok) throw Error(response.error + '\nLog: ' + dir.fsName + '/worker.log');
        try {
            if (input.remove) input.remove();
            if (output.remove) output.remove();
            if (cancel.remove) cancel.remove();
            var logFile = new File(dir.fsName + '/worker.log'); if (logFile.exists && logFile.remove) logFile.remove();
            var vbsFile = new File(dir.fsName + '/launch.vbs'); if (vbsFile.exists && vbsFile.remove) vbsFile.remove();
            if (dir.remove) dir.remove();
        } catch (_) {}
        return response.result;
    }
    function snapshot(doc, folder) {
        var copy = null;
        try {
            app.activeDocument = doc;
            copy = doc.duplicate('MTA snapshot', true);
            if (copy.mode !== DocumentMode.RGB) copy.changeMode(ChangeMode.RGB);
            copy.bitsPerChannel = BitsPerChannelType.EIGHT;
            var file = new File(folder.fsName + '/input.png');
            copy.saveAs(file, new PNGSaveOptions(), true, Extension.LOWERCASE);
            return file;
        } finally { if (copy) copy.close(SaveOptions.DONOTSAVECHANGES); app.activeDocument = doc; }
    }
    function bounds(layer) {
        var b = layer.bounds;
        return [b[0].as('px'), b[1].as('px'), b[2].as('px'), b[3].as('px')];
    }
    function addText(doc, group, region, translation, options) {
        var shape = region.shape && !region.safe_limit ? region.shape : null;
        var box = shape ? shape.box : region.safe, layer = doc.artLayers.add();
        var center = shape ? shape.center : [box[0]+box[2]/2,box[1]+box[3]/2];
        var previousQuotes=app.preferences.smartQuotes;
        try {
            if(typeof previousQuotes==='boolean')app.preferences.smartQuotes=false;
            layer.kind = LayerKind.TEXT;
            layer.name = region.id + ' | ' + translation.substr(0, 40).replace(/[\r\n]/g, ' ');
            var t = layer.textItem;
            t.kind = TextType.POINTTEXT;
            t.font = options.font;
            t.justification = Justification.CENTER;
            t.position = [UnitValue(doc.width.as('px')/2, 'px'), UnitValue(doc.height.as('px')/2, 'px')];
            t.useAutoLeading = false;
            t.antiAliasMethod = AntiAlias.SHARP;
            var color = new SolidColor(); color.rgb.red = 0; color.rgb.green = 0; color.rgb.blue = 0; t.color = color;
            var maxW = box[2] - 4, maxH = box[3] - 4;
            function measure(content) {
                t.contents = content || ' '; var b = bounds(layer);
                return [b[2] - b[0], b[3] - b[1]];
            }
            function shapeAttempt(size) {
                t.size=UnitValue(size*72/doc.resolution,'pt');
                t.leading=UnitValue(size*options.leading*72/doc.resolution,'pt');
                var lead=size*options.leading, ref=measure('ẤỮộgj'), maxLines=Math.min(24,Math.floor(box[3]/lead)+1);
                var widthCache={};
                function textWidth(content){var key='$'+content;if(widthCache[key]===undefined)widthCache[key]=measure(content)[0];return widthCache[key];}
                var paragraphs=translation.replace(/\r\n/g,'\n').replace(/\r/g,'\n').split('\n');
                for(var count=1;count<=maxLines;count++){
                    var top=center[1]-(ref[1]+(count-1)*lead)/2, lines=[], widths=[], bad=false;
                    for(var row=0;row<count;row++) widths.push(shapeWidth(shape,top+row*lead,top+row*lead+ref[1],center[0])-4);
                    for(var pi=0;pi<paragraphs.length;pi++){
                        var words=paragraphs[pi].replace(/^\s+|\s+$/g,'').split(/\s+/), line='';
                        for(var wi=0;wi<words.length;wi++){
                            var next=line?line+' '+words[wi]:words[wi];
                            if(line && textWidth(next)>(widths[lines.length]||0)){lines.push(line);line=words[wi];}else line=next;
                            if(lines.length>=count){bad=true;break;}
                        }
                        if(bad)break;lines.push(line);
                    }
                    if(bad)continue;
                    if(lines.length!==count){
                        // Greedy wrapping can oscillate: two narrow rows need
                        // three lines, while three wider rows greedily make two.
                        // Fit exactly the chosen row count before rejecting it.
                        lines=wrapToWidths(paragraphs,widths,textWidth);
                        if(!lines)continue;bad=false;
                    }
                    var content=lines.join('\r');measure(content);var all=bounds(layer);
                    var dx=center[0]-(all[0]+all[2])/2,dy=center[1]-(all[1]+all[3])/2;
                    for(var li=0;li<lines.length;li++){
                        measure(lines[li]);var b=bounds(layer), left=b[0]+dx,right=b[2]+dx;
                        if(!shapeRectFits(shape,left,b[1]+li*lead+dy,right,b[3]+li*lead+dy)){bad=true;break;}
                    }
                    if(!bad)return {fits:true,content:content,size:size};
                }
                return {fits:false,content:'',size:size};
            }
            function attempt(size) {
                if(shape)return shapeAttempt(size);
                t.size = UnitValue(size * 72 / doc.resolution, 'pt');
                t.leading = UnitValue(size * options.leading * 72 / doc.resolution, 'pt');
                var paragraphs = translation.replace(/\r\n/g, '\n').replace(/\r/g, '\n').split('\n');
                var lines = [], i, j;
                for (i = 0; i < paragraphs.length; i++) {
                    var words = paragraphs[i].replace(/^\s+|\s+$/g, '').split(/\s+/), line = '';
                    for (j = 0; j < words.length; j++) {
                        if (!words[j]) continue;
                        var next = line ? line + ' ' + words[j] : words[j];
                        if (line && measure(next)[0] > maxW) { lines.push(line); line = words[j]; }
                        else line = next;
                    }
                    lines.push(line);
                }
                var content = lines.join('\r'), sizePx = measure(content);
                return {fits: sizePx[0] <= maxW && sizePx[1] <= maxH, content: content, size: size};
            }
            var best = attempt(options.min);
            if (!best.fits) throw Error(region.id + ': bản dịch không vừa cỡ nhỏ nhất. Rút gọn hoặc sửa mapping/cỡ chữ.');
            var low = options.min, high = options.max;
            while (high - low >= .5) {
                var mid = (low + high) / 2, result = attempt(mid);
                if (result.fits) { best = result; low = mid; } else high = mid;
            }
            t.size = UnitValue(best.size * 72 / doc.resolution, 'pt');
            t.leading = UnitValue(best.size * options.leading * 72 / doc.resolution, 'pt');
            t.contents = best.content;
            var actual = bounds(layer);
            layer.translate(UnitValue(center[0] - (actual[0] + actual[2])/2, 'px'),
