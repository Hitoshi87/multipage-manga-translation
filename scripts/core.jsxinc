    // `layers` come from manga_ai/clean_layers.py: {id,file,x,y}. Returns how many layers
    // were created; on any failure the partial group is removed and 0 is returned so the
    // caller can fall back to the single overlay.
    function addRegionOverlays(doc, layers, options) {
        options = options || {};
        var ai = {}, i, made = 0, group = null;
        for (i = 0; i < (options.aiIds || []).length; i++) ai[options.aiIds[i]] = true;
        try {
            app.activeDocument = doc;
            group = doc.layerSets.add();
            group.name = options.title || 'CLEAN — từng bubble';
            for (i = 0; i < layers.length; i++) {
                var info = layers[i], image = null;
                try {
                    image = app.open(new File(info.file));
                    var layer = image.activeLayer.duplicate(doc, ElementPlacement.PLACEATBEGINNING);
                    image.close(SaveOptions.DONOTSAVECHANGES); image = null;
                    app.activeDocument = doc;
                    var got = bounds(layer);
                    layer.translate(UnitValue(info.x - got[0], 'px'), UnitValue(info.y - got[1], 'px'));
                    layer.name = info.id === 'REST' ? 'CLEAN (phần còn lại)' : (ai[info.id] ? 'CLEAN AI — CẦN DUYỆT ' : 'CLEAN ') + info.id;
                    layer.move(group, ElementPlacement.INSIDE);
