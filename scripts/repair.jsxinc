/* Repair previously exported editable pages without OCR, clean or API calls. */
var MTARepair=(function(){
    function nameRules(rows){
        if(!rows || rows.length>3)throw Error('Chỉ được đặt tối đa 3 cặp tên.');
        var rules=[],seen={};
        for(var i=0;i<rows.length;i++){
            var from=String(rows[i].from||'').replace(/^\s+|\s+$/g,'').replace(/\s+/g,' '),
                to=String(rows[i].to||'').replace(/^\s+|\s+$/g,'').replace(/\s+/g,' ');
            var drop=String(rows[i].dropAfter||'').replace(/^\s+|\s+$/g,'').replace(/\s+/g,' ');
            if(!from && !to){if(drop)throw Error('Cặp tên '+(i+1)+': cần nhập tên trước khi đặt phần cần bỏ.');continue;}
            if(!from || !to)throw Error('Cặp tên '+(i+1)+': cần nhập cả tên cũ và tên mới.');
            if(seen['$'+from.toLowerCase()])throw Error('Tên cũ bị trùng: '+from);
            if(from.length>100 || to.length>100)throw Error('Mỗi tên tối đa 100 ký tự.');
            if(drop.length>100)throw Error('Phần tên cần bỏ tối đa 100 ký tự.');
            var rule={from:from,to:to};if(drop)rule.dropAfter=drop;
            seen['$'+from.toLowerCase()]=true;rules.push(rule);
        }
        return rules;
    }
    function stripAllHonorifics(text){
        var spans=[],protectedText=/\{\{[^{}]+\}\}|\{[A-Za-z_][A-Za-z0-9_]*\}|%\([^)]+\)[a-zA-Z]|%[0-9]*\$?[sdif]|<[^<>]+>/g,m,count=0;
        while((m=protectedText.exec(text))!==null)spans.push([m.index,m.index+m[0].length]);
        var letter=/[A-Za-z\u00c0-\u024f\u0400-\u052f\u1e00-\u1eff\u3040-\u30ff\u3400-\u9fff]/,
            word=/[0-9A-Za-z_\u00c0-\u024f\u0300-\u036f\u0400-\u052f\u1e00-\u1eff\u3040-\u30ff\u3400-\u9fff]/;
        var clean=text.replace(/\s*[-\u2010-\u2015\u2212\uff0d]\s*(?:senpai|sensei|sama|chan|dono|san|kun)/gi,function(match,at,original){
            if(!letter.test(original.charAt(at-1)) || word.test(original.charAt(at+match.length)))return match;
            for(var i=0;i<spans.length;i++)if(at<spans[i][1] && at+match.length>spans[i][0])return match;
            count++;return '';
        });
        return {text:clean,count:count};
    }
    function replaceNames(text,rows,options){
        options=options||{};text=String(text);
        var rules=nameRules(rows),counts=[],parts=[],tokens=[],seen={},i;
        function escaped(s){return s.replace(/[.*+?^${}()|[\]\\]/g,'\\$&').replace(/ /g,'\\s+');}
        function token(name,index,rename){var key='$'+name.toLowerCase();if(seen[key])return;
            seen[key]=true;tokens.push({name:name,index:index,rename:rename});parts.push(escaped(name));}
        for(i=0;i<rules.length;i++){counts.push(0);token(rules[i].from,i,true);}
        // Explicit old-name rules take precedence over cleanup of a new name.
        for(i=0;i<rules.length;i++)if(options.stripHonorifics || rules[i].dropAfter)token(rules[i].to,i,false);
        var result={text:text,count:0,counts:counts,honorifics:0,trimmed:0};
        function finish(){if(options.stripHonorifics && options.allNames){var clean=stripAllHonorifics(result.text);
            result.text=clean.text;result.count+=clean.count;result.honorifics+=clean.count;}return result;}
        if(!rules.length)return finish();
        parts.sort(function(a,b){return b.length-a.length;});
        var word=/[0-9A-Za-z_\u00c0-\u024f\u0300-\u036f\u0400-\u052f\u1e00-\u1eff\u3040-\u30ff\u3400-\u9fff]/;
        // Require a dash: bare Vietnamese verbs such as "san" and "chan"
        // can legitimately follow a character's name.
        var honor=/^\s*[-\u2010-\u2015\u2212\uff0d]\s*(?:senpai|sensei|sama|chan|dono|san|kun)/i;
        var regex=new RegExp(parts.join('|'),'gi'),cursor=0,pieces=[],found;
        while((found=regex.exec(text))!==null){
            var at=found.index,match=found[0],end=at+match.length;
            if((at>0 && word.test(text.charAt(at-1))) || word.test(text.charAt(end)))continue;
            for(var r=0;r<tokens.length;r++)if(new RegExp('^'+escaped(tokens[r].name)+'$','i').test(match)){
                var index=tokens[r].index,rule=rules[index],replacement=tokens[r].rename?rule.to:match;
                if(match.toUpperCase()!==match.toLowerCase()){
                    if(match===match.toUpperCase())replacement=replacement.toUpperCase();
                    else if(match===match.toLowerCase())replacement=replacement.toLowerCase();
                }
                var trimmed=false,progress=true;
                while(progress){progress=false;var suffix=null;
                    if(options.stripHonorifics){
                        suffix=honor.exec(text.substr(end));
                        if(suffix && !word.test(text.charAt(end+suffix[0].length))){
                            end+=suffix[0].length;result.honorifics++;progress=true;continue;
                        }
                    }
                    if(rule.dropAfter && !trimmed){
                        suffix=new RegExp('^\\s+'+escaped(rule.dropAfter),'i').exec(text.substr(end));
                        if(suffix && !word.test(text.charAt(end+suffix[0].length))){
                            end+=suffix[0].length;trimmed=true;result.trimmed++;progress=true;
                        }
                    }
                }
                if(text.substring(at,end)!==replacement){result.count++;counts[index]++;}
                pieces.push(text.substring(cursor,at));pieces.push(replacement);cursor=end;regex.lastIndex=end;
                break;
            }
        }
        pieces.push(text.substr(cursor));result.text=pieces.join('');return finish();
    }
    function inkBounds(layer){
        var b=layer.boundsNoEffects;
        return [b[0].as('px'),b[1].as('px'),b[2].as('px'),b[3].as('px')];
    }
    function inventory(folder,depth){
        if((depth||0)>16)throw Error('Không tìm được checkpoint gốc của thư mục kết quả.');
        var logs=folder.getFiles('draft_*.json'), byName={}, items=[],i,j,k;
        if(!logs.length){
            var chain=new File(folder.fsName+'/repair_log.json');
            if(!chain.exists)chain=new File(folder.fsName+'/rename_log.json');
            if(chain.exists && folder.parent && folder.parent.fsName!==folder.fsName){
                var previous=MJSON.parse(MTA.read(chain)),parents=inventory(folder.parent,(depth||0)+1),source={};
                for(i=0;i<parents.length;i++)source['$'+parents[i].file.fsName]=parents[i].page;
                for(i=0;i<(previous.pages||[]).length;i++){
                    var entry=previous.pages[i],output=entry.output?new File(entry.output):null;
                    if(output && output.exists && output.parent.fsName===folder.fsName && source['$'+entry.input])
                        items.push({file:output,page:source['$'+entry.input]});
                }
                if(items.length)return items;
            }
        }
        logs.sort(function(a,b){return b.modified.getTime()-a.modified.getTime();});
        for(i=0;i<logs.length;i++){
            var saved=MJSON.parse(MTA.read(logs[i])),pages=saved.pages||[];
            for(j=0;j<pages.length;j++)for(k=0;k<2;k++){
                var path=(pages[j].files||{})[k?'psd':'pdf'];if(!path)continue;
                var name=(new File(path)).name;
                if(!byName['$'+name])byName['$'+name]=pages[j];
            }
        }
        if(!logs.length)throw Error('Thư mục cần có checkpoint draft_*.json của tool để xác định khung thoại.');
        var files=folder.getFiles(function(f){return f instanceof File && /\.(pdf|psd)$/i.test(f.name);});
        files.sort(function(a,b){return a.name<b.name?-1:(a.name>b.name?1:0);});
        for(i=0;i<files.length;i++)if(byName['$'+files[i].name])items.push({file:files[i],page:byName['$'+files[i].name]});
        if(!items.length)throw Error('Không tìm thấy PDF/PSD khớp checkpoint.');
        return items;
    }
    function repairDocument(doc,manifest,tick,options){
        options=options||{};var rules=options.names?nameRules(options.names):null;
        if(Math.abs(doc.width.as('px')-manifest.width)>2 || Math.abs(doc.height.as('px')-manifest.height)>2)
            throw Error('Kích thước trang đã đổi; cần duyệt lại tọa độ thoại.');
        var layers=[],result={fixed:0,replacements:0,honorifics:0,trimmed:0,errors:[],counts:[]};
        for(var rule=0;rules && rule<rules.length;rule++)result.counts.push(0);
        function collect(group){for(var i=0;i<group.layers.length;i++){
            var layer=group.layers[i];if(layer.typename==='LayerSet')collect(layer);
            else if(layer.kind===LayerKind.TEXT && /B\d{3}\s*\|/.test(layer.name))layers.push(layer);
        }}
        collect(doc);
        result.unchanged=!layers.length && (!manifest.regions.length || options.allowEmpty===true);
        if(!layers.length && !result.unchanged)throw Error('Không có layer thoại của tool; PDF có thể đã flatten.');
        for(var i=0;i<layers.length;i++){
            var old=layers[i],id=old.name.match(/B\d{3}(?=\s*\|)/)[0],region=null,fit=null,replacement=null;
            if(tick && tick('Sửa khung thoại '+id)===false)throw Error('Đã hủy');
            try{
                var content=old.textItem.contents.replace(/\r\n|\r|\n/g,' '),renamed=rules?replaceNames(content,rules,options):null;
                if(renamed && !renamed.count)continue;
                if(renamed)content=renamed.text;
                for(var j=0;j<manifest.regions.length;j++)if(manifest.regions[j].id===id)region=manifest.regions[j];
                if(!region)throw Error('Không tìm thấy vùng thoại '+id);
                var t=old.textItem,size=t.size.as('pt')*doc.resolution/72;
                var fitOptions={font:t.font,min:Math.max(4,size*.5),max:Math.max(4,size),leading:1.3,autoLeading:true,caseMode:'keep',sparseBoost:1};
                if(options.sizing && options.sizing.sizePolicy!=='adaptive'){
                    fitOptions.sizePolicy=options.sizing.sizePolicy;fitOptions.standardSize=options.sizing.standardSize;
                    fitOptions=MTA.letteringSizeOptions(fitOptions,Math.max(1,Math.min(doc.width.as('px')/1008,doc.height.as('px')/1440)));
                }
                fit=MTA.addText(doc,old.parent,region,content,fitOptions);
                // Retain the original colour, layer effects, visibility and opacity.
                replacement=old.duplicate();var dest=replacement.textItem,src=fit.textItem;
                dest.kind=TextType.PARAGRAPHTEXT;dest.size=src.size;
                dest.justification=Justification.CENTER;dest.useAutoLeading=src.useAutoLeading;
                if(src.useAutoLeading)dest.autoLeadingAmount=src.autoLeadingAmount;else dest.leading=src.leading;
                dest.width=src.width;dest.height=src.height;dest.position=src.position;dest.contents=src.contents;
                var a=inkBounds(fit),b=inkBounds(replacement);
                if(Math.abs((a[2]-a[0])-(b[2]-b[0]))>2 || Math.abs((a[3]-a[1])-(b[3]-b[1]))>2)
                    throw Error('Style chữ cũ cần duyệt lại; giữ nguyên layer.');
                // Point -> paragraph conversion changes Photoshop's anchor.
                // Align visible glyphs, excluding the original outline effects.
                replacement.translate(UnitValue((a[0]+a[2]-b[0]-b[2])/2,'px'),UnitValue(a[1]-b[1],'px'));
                b=inkBounds(replacement);
                for(var c=0;c<4;c++)if(Math.abs(a[c]-b[c])>2)throw Error('Không căn khớp được khung thoại; giữ nguyên layer.');
                replacement.name=renamed?old.name.replace(/\|[\s\S]*$/,'| '+content.substr(0,40)):old.name;
                fit.remove();fit=null;old.remove();replacement=null;result.fixed++;
                if(renamed){result.replacements+=renamed.count;result.honorifics+=renamed.honorifics;result.trimmed+=renamed.trimmed;
                    for(var n=0;n<renamed.counts.length;n++)result.counts[n]+=renamed.counts[n];}
            }catch(e){
                if(fit)fit.remove();if(replacement)replacement.remove();
                result.errors.push({id:id,error:String(e.message||e)});
            }
        }
        return result;
    }
    function runFolder(folder,tick,options){
        options=options||{};var rules=options.names?nameRules(options.names):null;
        if(options.sizing)MTA.letteringSizeOptions({min:4,max:250,sizePolicy:options.sizing.sizePolicy,standardSize:options.sizing.standardSize},1);
        if(rules && !rules.length && !(options.stripHonorifics && options.allNames))throw Error('Hãy nhập ít nhất một cặp tên hoặc bật bỏ kính ngữ mọi tên.');
        var items=inventory(folder),out=MTA.mkdir(folder.fsName+(rules?'/DOI_TEN':'/SUA_THOAI')),
            logFile=new File(out.fsName+(rules?'/rename_log.json':'/repair_log.json'));
        var log={revision:rules?'names-v3':'paragraph-v1',names:rules,stripHonorifics:options.stripHonorifics===true,allNames:options.allNames===true,pages:[],cancelled:false},prior=null;
        if(logFile.exists)prior=MJSON.parse(MTA.read(logFile));
        if(prior && MJSON.stringify(prior.names||null)!==MJSON.stringify(rules))prior=null;
        if(prior && !!prior.stripHonorifics!==log.stripHonorifics)prior=null;
        if(prior && !!prior.allNames!==log.allNames)prior=null;
        log.sizing=options.sizing||null;
        if(prior && MJSON.stringify(prior.sizing||null)!==MJSON.stringify(log.sizing))prior=null;
        if(prior && prior.revision===log.revision)log.pages=prior.pages.slice(0);
        function record(row){
            for(var r=0;r<log.pages.length;r++)if(log.pages[r].input===row.input){log.pages[r]=row;return;}
            log.pages.push(row);
        }
        var active=app.documents.length?app.activeDocument:null,dialogs=app.displayDialogs,ruler=app.preferences.rulerUnits;
        try{
            app.displayDialogs=DialogModes.NO;app.preferences.rulerUnits=Units.PIXELS;
            for(var i=0;i<items.length;i++){
                var item=items[i],file=item.file,stamp=String(file.length)+'@'+file.modified.getTime(),old=null,doc=null;
                if(tick && tick('Trang '+(i+1)+'/'+items.length+': '+decodeURI(file.name),100*i/items.length)===false){log.cancelled=true;break;}
                if(prior && prior.revision===log.revision)for(var p=0;p<prior.pages.length;p++)
                    if(prior.pages[p].input===file.fsName && prior.pages[p].stamp===stamp && prior.pages[p].status==='complete' && MTA.validOutput(prior.pages[p].output))old=prior.pages[p];
                if(old){record(old);continue;}
                var row={input:file.fsName,stamp:stamp,status:'failed'};
                try{
                    for(var d=0;d<app.documents.length;d++){
                        var openPath=null;try{openPath=app.documents[d].fullName.fsName;}catch(_){}
                        if(openPath===file.fsName)throw Error('File đang mở trong Photoshop; đóng file rồi chạy lại để sửa trang này.');
                    }
                    var manifest=MJSON.parse(MTA.read(new File(item.page.manifest)));
                    doc=app.open(file);var result=repairDocument(doc,manifest,tick,{names:rules,stripHonorifics:options.stripHonorifics===true,allNames:options.allNames===true,sizing:options.sizing,allowEmpty:item.page.required===0});
                    row.fixed=result.fixed;row.errors=result.errors;row.replacements=result.replacements;row.counts=result.counts;
                    row.honorifics=result.honorifics;row.trimmed=result.trimmed;
                    if(!result.fixed && ((!rules && !result.unchanged) || result.errors.length))throw Error('Không sửa được thoại nào; xem lỗi vùng trong log.');
                    if(!result.fixed){
                        doc.close(SaveOptions.DONOTSAVECHANGES);doc=null;
                        var target=new File(out.fsName+'/'+file.name),suffix=1;
                        while(target.exists)target=new File(out.fsName+'/'+file.name.replace(/(\.[^.]+)$/,'_'+(suffix++)+'$1'));
                        if(!file.copy(target.fsName))throw Error('Không sao chép được trang không có tên cần đổi.');
                        row.output=target.fsName;row.unchanged=true;
                    }else{
                        var saved={};MTA.saveCopy(doc,out,decodeURI(file.name),
                            {psd:/\.psd$/i.test(file.name),pdf:/\.pdf$/i.test(file.name),pdfLayers:true},'chapter',saved);
                        row.output=saved.pdf||saved.psd;
                    }
                    row.status=result.errors.length?'needs_attention':'complete';
                }catch(e){row.error=String(e.message||e);if(/Đã hủy/.test(row.error))log.cancelled=true;}
                finally{if(doc)doc.close(SaveOptions.DONOTSAVECHANGES);if(!app.documents.length){try{app.purge(PurgeTarget.ALLCACHES);}catch(_){}try{$.gc();}catch(_){}}}
                record(row);MTA.writeCheckpoint(logFile,MJSON.stringify(log));
                if(log.cancelled)break;
            }
        }finally{
            if(active)app.activeDocument=active;app.displayDialogs=dialogs;app.preferences.rulerUnits=ruler;
            MTA.writeCheckpoint(logFile,MJSON.stringify(log));
        }
        return {folder:out,log:log};
    }
    return {inventory:inventory,repairDocument:repairDocument,runFolder:runFolder,nameRules:nameRules,replaceNames:replaceNames,stripAllHonorifics:stripAllHonorifics};
})();
